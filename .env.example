APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mangov2
DB_USERNAME=root
DB_PASSWORD=

# Knowledge base car catalog: a separate read-only database (host and user default to DB_*).
# Its logos and photos live in storage/app/public/auto (mark_small, mark_dark, serie), see `php artisan storage:link`.
AUTO_RU_DB_DATABASE=auto_ru
# AUTO_RU_DB_HOST=
# AUTO_RU_DB_USERNAME=
# AUTO_RU_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Realtime (Reverb). Для работы сигналов: BROADCAST_CONNECTION=reverb, запущенные
# reverb:start и обработчик очереди broadcasts. Без VITE_REVERB_APP_KEY интерфейс
# работает без обновлений в реальном времени.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Где слушает сам сервер Reverb (только локальный адрес).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Публичный адрес для браузера (локально — прямое подключение).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Внутренний адрес, по которому приложение публикует события в Reverb.
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_INTERNAL_PORT=8080
REVERB_INTERNAL_SCHEME=http
# Разрешённые Origin браузера через запятую (хосты, допускается *).
REVERB_ALLOWED_ORIGINS=localhost

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
